# Owtranet instance configuration. Copy to .env and fill in; never commit .env.
# Only the "Required" block is needed to run. Everything else enables an
# optional feature and can stay blank.

# ---- Required ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=owtranet
DB_PASSWORD=
DB_NAME=owtranet
# Long random string: openssl rand -hex 32
JWT_SECRET=
PORT=3006
NODE_ENV=production
BASE_URL=https://intranet.example.com
CORS_ORIGIN=https://intranet.example.com
# Set to false only when serving over plain HTTP (local / Docker quickstart)
CSP_UPGRADE_INSECURE_REQUESTS=true

# ---- Branding (UI, e-mails, AI agent prompts) -------------------------------
COMPANY_NAME=Example Co
COMPANY_SHORT_NAME=Example
# Domain of member mailboxes (e.g. jane@example.com), if you host mail
COMPANY_EMAIL_DOMAIN=example.com
# Reporting currency for the ledger / investment tracker
BASE_CURRENCY=USD
# Where "someone tried to sign in with an unknown address" alerts go (blank = none)
ADMIN_NOTIFY_EMAIL=

# ---- Outbound e-mail (SMTP relay: Amazon SES, SendGrid, …) -------------------
SES_SMTP_HOST=
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM_EMAIL=noreply@example.com

# ---- Self-hosted mail (Postfix/Dovecot on the same box; see docs/EMAIL_SYSTEM_ARCHITECTURE.md)
# Member mail + calendar provider default: self_hosted | microsoft_365 | google_workspace
DEFAULT_EMAIL_PROVIDER=self_hosted
MAIL_SYSTEM_ADDRESS=system@example.com
MAIL_SMTP_PASSWORD=
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=587
MAIL_BASE_DIR=/var/mail
MAIL_USER_SUFFIX=intranet
# Encrypts stored webmail passwords (defaults to JWT_SECRET)
EMAIL_ENCRYPTION_KEY=
# Receipt-by-email ingestion (email-receipt-processor.js)
RECEIPT_MAILBOX=receipts@example.com
RECEIPT_ADMIN_EMAIL=

# ---- Payroll fields in agreements (SIN, banking) -----------------------------
# AES-256-GCM key, 64 hex chars: openssl rand -hex 32. Unique per instance.
# The server refuses to start if payroll-enabled agreements exist and this is missing.
PAYROLL_ENCRYPTION_KEY=

# ---- AI (Anthropic Claude) ---------------------------------------------------
# Document/receipt analysis, AI agents, radio summaries
ANTHROPIC_API_KEY=
AGENT_REPLY_MODEL=claude-opus-5
AGENT_REPLIES_PER_POST_PER_HOUR=
AGENT_REPLIES_PER_HOUR=
AGENT_DM_REPLIES_PER_SENDER_PER_HOUR=
AGENT_GROUP_REPLIES_PER_CHANNEL_PER_HOUR=

# ---- Voice agent (ElevenLabs; mobile "Call AI") ------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_NAME=
# Only for server/scripts/syncElevenLabsAgentTools.js — pass on the command line
# VOICE_AGENT_INTRANET_API_KEY=

# ---- GitHub ------------------------------------------------------------------
GITHUB_TOKEN=
# Issues synced into the intranet: owner/repo,owner/other
GITHUB_SYNC_REPOS=
# Doc sweep (Admin → Search Adapters)
GITHUB_DOCS_TOKEN=
GITHUB_DOCS_SITE_BASE=

# ---- Mobile app + Corporate Radio -------------------------------------------
MOBILE_MIN_APP_VERSION=1.0.0
IOS_APP_ID=TEAMID.com.example.owtranet
ANDROID_PACKAGE=com.example.owtranet
ANDROID_CERT_SHA256=
RADIO_MODEL=claude-opus-5
RADIO_BACKFILL_DAYS=30
RADIO_WORKER_INTERVAL_SECS=300
PUSH_DISPATCH_INTERVAL_SECS=20
SCHEDULED_EMAIL_INTERVAL_SECS=30
# Android push (FCM HTTP v1): service-account JSON file (or inline JSON)
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
# iOS push (APNs .p8 auth key)
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.owtranet
APNS_ENV=production

# ---- Instance plugins (docs/PLUGINS.md) -------------------------------------
# Directory holding this deployment's plugins/ and public/. Unset = none.
INSTANCE_DIR=
# 1 = a failing plugin aborts startup instead of being skipped
PLUGINS_STRICT=
