# Config for the hosted HTTP entrypoint (http.js). Copy to .env, chmod 600.
# Not needed for the local stdio server (index.js), which uses `npm run login`.

# Shared secret that callers (ElevenLabs "Secret Token") must send as
# `Authorization: Bearer <secret>`. Generate with: openssl rand -hex 32
MCP_WEBMAIL_SECRET=

# intranet users.id whose linked mailbox (server_email_accounts.linked_user_id)
# the tools expose. Optional email/role become claims in the minted JWT.
MCP_WEBMAIL_USER_ID=
MCP_WEBMAIL_USER_EMAIL=
MCP_WEBMAIL_USER_ROLE=user

# Listener + path (nginx proxies https://<host>/mcp/ -> this port).
MCP_WEBMAIL_PORT=3010
MCP_WEBMAIL_PATH=/mcp/webmail

# Local intranet app to call. Defaults to the same box's port 3006.
INTRANET_BASE_URL=http://127.0.0.1:3006

# Leave unset to reuse the intranet's JWT_SECRET from ../.env
# JWT_SECRET=
