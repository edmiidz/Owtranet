# Minimal .env for `docker compose up`. Copy to .env and fill in the four
# required values. Never commit .env.
#
# Any other setting from .env.example (AI agents, SMTP, branding, mobile push…)
# can be added here too.

# ---- Required ---------------------------------------------------------------
# Long random strings, e.g.: openssl rand -hex 32
JWT_SECRET=
DB_PASSWORD=

# First admin account, created only when the database has no admin yet.
# You can remove ADMIN_PASSWORD from this file after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Optional ---------------------------------------------------------------
# The URL people open in the browser (must match exactly, including the port).
BASE_URL=http://localhost:3006
# Host port to publish on
OWTRANET_PORT=3006

COMPANY_NAME=Example Co
COMPANY_SHORT_NAME=Example
COMPANY_EMAIL_DOMAIN=example.com

# Enables the @assistant AI teammate and receipt analysis
ANTHROPIC_API_KEY=
